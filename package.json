{
  "name": "revgate",
  "version": "0.2.0",
  "description": "Human-in-the-loop, GitHub-style review for GitHub Copilot CLI. Manual-first: /revgate-review and /revgate-plan run on demand, with one automatic exception — plan mode is gated via preToolUse.",
  "type": "module",
  "bin": {
    "revgate": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "public",
    "hooks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
