.DS_Store

# PowerShell drops Microsoft/Windows/PowerShell/ModuleAnalysisCache into the
# working directory it was started in. It was committed once by accident; ignore
# it so the next `git add -A` cannot bring it back.
Microsoft/

# `install.ps1 -Repo .` writes this clone's hook here, pinned to an absolute
# path to *this* machine's dist/index.js. Committing it would hand every other
# clone a preToolUse hook that cannot run — and preToolUse fails closed.
.github/hooks/
